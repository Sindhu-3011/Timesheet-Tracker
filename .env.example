# ============================================================
# Timesheet Tracker — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ----------------------------
# Server
# ----------------------------
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ----------------------------
# Storage Paths
# ----------------------------
UPLOAD_DIR=uploads
DB_FILE=users.db

# ----------------------------
# OCR — Tesseract (Windows)
# Point to the folder that contains tesseract.exe.
# Leave blank on Linux/macOS if Tesseract is on PATH.
# ----------------------------
TESSERACT_DIR=

# ----------------------------
# Feature Flags
# ----------------------------
# Auto-lock NTT timesheet after OCR autofill (true/false)
AUTO_LOCK_NTT_ON_OCR=true

# ----------------------------
# Default Admin Seed
# Used ONLY when the database has no users (first run).
# Change these before going live.
# ----------------------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ----------------------------
# SMTP Email (for automated reminders)
# ----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to true only for port 465 (SMTP_SSL)
SMTP_SSL=false
